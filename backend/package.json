{
  "name": "aegispay-backend",
  "version": "1.0.0",
  "description": "Backend API for AegisPay - Merchant Purpose Drift and Betting Front Detection System",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "osm:sync": "tsx src/scripts/syncOsm.ts",
    "osm:sync:snapshot": "tsx src/scripts/syncOsm.ts --snapshot"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
